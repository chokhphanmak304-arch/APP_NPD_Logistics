<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 ขึ้นไป ระบบวาดหน้าเปิดแอปเอง (SplashScreen API) และไม่สนใจ
         windowBackground อีกต่อไป ต้องบอกสีพื้นผ่าน windowSplashScreenBackground
         ไม่งั้นระบบจะไปหยิบ colorBackground ของธีมมาใช้ ซึ่งเปลี่ยนตามโหมดเครื่อง -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
