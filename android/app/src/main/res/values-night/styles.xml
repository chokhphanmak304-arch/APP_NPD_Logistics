<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ธีมตอนเครื่องตั้งเป็นโหมดมืด

         ตัวแอปเป็นพื้นขาวทั้งหมด (MaterialApp ไม่ได้กำหนด darkTheme ไว้)
         หน้าเปิดแอปจึงต้องขาวตามให้ตรงกัน ไม่งั้นจะเห็นจอดำแวบหนึ่ง
         แล้วค่อยกระโดดเป็นขาว ดูเหมือนแอปค้าง
         จึงใช้ parent เป็น Theme.Light เหมือนโหมดสว่างทุกประการ -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
